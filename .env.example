# Google Apps Script web-app /exec URL (Deploy → New deployment → Web app)
VITE_ENQUIRY_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
# Must match SHARED_SECRET in apps-script/Code.gs.
# Note: this ships in the client bundle — it deters casual endpoint abuse, it is not a credential.
VITE_ENQUIRY_SECRET=change-me
